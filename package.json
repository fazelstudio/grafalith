{
  "name": "nary",
  "private": true,
  "description": "Nary monorepo root — Rust canvas engine (crates/*) with Tauri desktop demo (apps/desktop). Engine distributed as @fazelstudio/nary (npm/WASM) and nary (PyPI).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "cargo test --workspace",
    "typecheck": "cargo clippy --workspace --all-targets -- -D warnings",
    "lint": "eslint .",
    "fmt": "cargo fmt --all",
    "fmt:check": "cargo fmt --all -- --check",
    "build": "cargo build --workspace",
    "build:release": "cargo build --workspace --release",
    "build:wasm": "wasm-pack build crates/nary --target bundler --out-dir ../../pkg/bundler --scope fazelstudio",
    "build:wasm:node": "wasm-pack build crates/nary --target nodejs --out-dir ../../pkg/node --scope fazelstudio",
    "build:python": "maturin build -m crates/nary-python/Cargo.toml",
    "publish:python": "maturin build -m crates/nary-python/Cargo.toml && maturin upload dist/*",
    "dev:python": "maturin develop -m crates/nary-python/Cargo.toml",
    "dev:desktop": "bun run --filter @fazelstudio/desktop dev",
    "tauri": "bun run --filter @fazelstudio/desktop tauri",
    "tauri:dev": "bun run --filter @fazelstudio/desktop tauri:dev",
    "tauri:build": "bun run --filter @fazelstudio/desktop tauri:build",
    "verify:docs": "python3 scripts/verify-docs.py",
    "verify:bindings": "python3 scripts/gen_command_bindings.py --check",
    "i18n:verify": "bun run --filter @fazelstudio/desktop i18n:verify",
    "clean": "rimraf node_modules apps/desktop/node_modules packages/*/node_modules target apps/desktop/src-tauri/target examples/*/target pkg dist apps/desktop/dist coverage .venv venv \"**/__pycache__\" \"**/*.egg-info\" \"**/*.tsbuildinfo\""
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "rimraf": "^6.0.0",
    "typescript-eslint": "^8"
  }
}
